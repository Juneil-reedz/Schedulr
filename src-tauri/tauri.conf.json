{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Schedulr",
  "version": "1.2.0",
  "identifier": "com.schedulr.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Schedulr",
        "width": 1360,
        "height": 900,
        "minWidth": 420,
        "minHeight": 620,
        "visible": false,
        "center": true,
        "backgroundColor": "#F2E9DB"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://backend.composio.dev https://api.web3forms.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Schedulr",
    "category": "Productivity",
    "shortDescription": "Local-first floral desktop scheduler",
    "longDescription": "Schedulr keeps your events, meetings, tasks and reminders on your own laptop, in a handcrafted floral clay design.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGREMyQUQxMkI2MjE1Q0UKUldUT0ZXSXIwU3JjZit5WGU1OFFUdHVvYnpkY09TcGd4LzdxYWVicUNPWitmb1hXeUFTV1l5TmEK",
      "endpoints": [
        "https://github.com/Juneil-reedz/Schedulr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
